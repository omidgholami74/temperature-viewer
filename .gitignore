# Runtime data (never commit the SQLite database)
backend/var/*.sqlite
backend/var/*.sqlite-wal
backend/var/*.sqlite-shm

# Board credentials (Wi-Fi password, ingest key)
module/config.py
esp32-s3/common/config.py
esp32-s3/**/config.py
esp32-s3/**/config.h

# Arduino build output
build/

# Pico logs and the collector's spool/checkpoint
*.jsonl
module/samples.jsonl.old
collector/data/

# Python
__pycache__/
*.py[cod]

# Logs and local artifacts
logs/
*.log

# Operating system
.DS_Store
Thumbs.db
