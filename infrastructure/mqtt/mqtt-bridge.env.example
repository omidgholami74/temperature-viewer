# Copy to /etc/furnace/mqtt-bridge.env and fill in the secrets.
#   sudo install -m 600 -o furnace -g furnace mqtt-bridge.env /etc/furnace/
# The bridge is started by furnace-mqtt-bridge.service and reads this file.

# --- broker -----------------------------------------------------------------
# The bridge runs on the same host as the broker, so loopback is enough and
# the traffic never crosses the network.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=furnace-bridge
MQTT_PASSWORD=change-me
MQTT_TLS=0
# MQTT_CAFILE=/etc/ssl/certs/ca-certificates.crt

# Empty = accept every site on the broker. Set it (for example "razi") to
# ignore boards belonging to another installation.
MQTT_SITE=

# --- API --------------------------------------------------------------------
# Same host as the PHP API. Use the public https URL only if the bridge runs
# somewhere else.
API_URL=http://127.0.0.1/api/ingest
# Must equal FURNACE_INGEST_KEY on the server. Empty when the API is open
# (trusted local network only).
API_KEY=
API_TIMEOUT_S=10
API_RETRIES=3

# Frames accepted in a single message (the API limit is 600).
MAX_FRAMES=600
